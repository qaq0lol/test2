<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统设置与连接监视"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前连接数据 · 历史所有总流量"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_close_settings_top"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        android:layout_marginBottom="12dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: 当前连接数据 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📡 当前连接数据 (CONNECTION DATA)"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_connection_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_rounded_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="ESTABLISHED"
                    android:textColor="@color/status_green"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_rounded_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="当前出口 IP:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/settings_outbound_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="103.224.182.24"
                        android:textColor="@color/status_green"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="目标服务器地址:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/settings_remote_endpoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mel-224-wg.whiskergalaxy.com:1194"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="协议与传输通道:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/settings_protocol_channel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WireGuard (UDP 专线)"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本地虚拟 TUN 地址:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/settings_tun_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10.14.0.2 / 32"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="实时速率:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/settings_realtime_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↓ 0.0 KB/s · ↑ 0.0 KB/s"
                        android:textColor="@color/status_green"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本次已连时长:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/settings_uptime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Jump to Requests Tab -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_goto_requests"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📶 查看实时网络连接与请求记录 (类似 FlClash) →"
                android:textSize="11sp"
                android:textColor="@color/brand_primary"
                android:layout_marginBottom="14dp"
                app:cornerRadius="12dp" />

            <!-- Section 2: 历史所有流量统计 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 历史所有流量统计 (所有累计)"
                    android:textColor="@color/status_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_reset_traffic_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重置统计"
                    android:textColor="@color/status_red"
                    android:textSize="11sp"
                    android:padding="4dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="记录应用自安装以来产生的全部历史总流量"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <!-- Historical Traffic Cards Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/badge_rounded_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="历史所有总下载"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/settings_all_time_dl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="148.62 GB"
                        android:fontFamily="monospace"
                        android:textColor="@color/status_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="历史全部累计"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/badge_rounded_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="历史所有总上传"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/settings_all_time_ul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="21.48 GB"
                        android:fontFamily="monospace"
                        android:textColor="@color/brand_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="历史全部累计"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Session Retain Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_rounded_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本次连接消耗 (本次保留):"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/settings_session_traffic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↓ 0 B / ↑ 0 B"
                        android:textColor="@color/status_green"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="历史所有流量总和:"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/settings_all_time_sum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="170.10 GB"
                        android:textColor="@color/status_orange"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="历史累计连接次数:"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/settings_connect_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="38 次"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Close Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_settings_bottom"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="完成并返回"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
