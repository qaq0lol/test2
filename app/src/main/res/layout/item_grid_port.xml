<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_port"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_port_grid_item"
    android:padding="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Row: Protocol tag + Ping Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_active"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/badge_rounded_bg"
                android:backgroundTint="@color/status_green"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_port_proto_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WG UDP"
                android:textColor="@color/brand_primary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_port_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测速"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:padding="2dp" />
    </LinearLayout>

    <!-- Bottom Row: :port number + active text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/tv_port_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=":443"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_port_active_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前使用"
            android:textColor="@color/status_green"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
