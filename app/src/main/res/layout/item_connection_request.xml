<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Target Host / Port Monospace Bold -->
        <TextView
            android:id="@+id/tv_request_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="tcp://api.bilibili.com:443" />

        <!-- Timing and Traffic -->
        <TextView
            android:id="@+id/tv_request_traffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:text="刚刚 · 517B ↑ 0B ↓" />

        <!-- Node & Rule Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_request_node"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_rounded_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:text="🇩🇪 德国A1 6 | 0.7倍 | V1" />

            <TextView
                android:id="@+id/tv_request_rule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/badge_rounded_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/brand_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:text="GLOBAL" />
        </LinearLayout>
    </LinearLayout>

    <!-- Disconnect single connection button ⊘ -->
    <TextView
        android:id="@+id/btn_disconnect_request"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="⊘"
        android:textColor="@color/status_red"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
