<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_port_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_port_item"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp">

    <!-- Active Selection Radio -->
    <RadioButton
        android:id="@+id/rb_port_selected"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:clickable="false"
        android:focusable="false"
        android:layout_marginEnd="6dp" />

    <!-- Protocol Badge -->
    <TextView
        android:id="@+id/tv_port_proto_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_rounded_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="WG"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginEnd="8dp" />

    <!-- Port Number & Host Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_port_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="端口 443"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_port_host"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="au.wireopen.net"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Speed Test / Latency Badge -->
    <TextView
        android:id="@+id/tv_port_latency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_latency_badge"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="测速"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
